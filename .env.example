# Copy this file to .env and fill in the values. Never commit .env.

# Database (matches docker-compose.yml for local development).
# In production, paste Neon's connection string as-is; "postgresql://" is converted automatically.
DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# Test database used by pytest (created by docker/initdb on first start)
TEST_DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq_test

# Auth. Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Uploads. STORAGE_BACKEND is "local" (files on disk in UPLOAD_DIR) or "db" (files stored in Postgres)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_PAGES=10

# LLM provider: "gemini" (free tier, default) or "anthropic" (paid).
# LLM_API_KEY is the key for that provider:
#   gemini    -> free key from https://aistudio.google.com/apikey
#   anthropic -> key from https://console.anthropic.com
# Gemini free tier: Google may use inputs to improve its products, so only send
# synthetic or demo invoices, never real customer data.
LLM_PROVIDER=gemini
LLM_API_KEY=
# gemini-3.5-flash-lite has a larger free daily quota; gemini-3.8-flash allows only ~20 requests/day.
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Claude only: reasoning effort for extraction (low | medium | high | xhigh | max)
LLM_EFFORT_EXTRACT=medium
# Kill switch: set to false to stop all LLM calls
EXTRACTION_ENABLED=true
EXTRACTION_MAX_RETRIES=2
RENDER_MAX_EDGE=2000

# Embeddings (used from Phase 5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Tracing with Langfuse (optional; leave empty to skip tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Cost control and agent behaviour
# Budgets are enforced from Phase 6. Gemini free tier costs $0; Claude Opus 5.5 about $0.05-0.10 per invoice.
MAX_COST_PER_INVOICE_USD=0.25
DAILY_BUDGET_USD=2.00
AUTO_APPROVE_ENABLED=false

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
