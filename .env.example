# Copy this file to .env and fill in the values. Never commit .env.

# Database (matches docker-compose.yml for local development).
# In production, paste Neon's connection string as-is; "postgresql://" is converted automatically.
DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# Test database used by pytest (created by docker/initdb on first start)
TEST_DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq_test

# Auth. Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Uploads. STORAGE_BACKEND is "local" (files on disk in UPLOAD_DIR) or "db" (files stored in Postgres)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_PAGES=10

# LLM provider: "gemini" (free tier, default) or "anthropic" (paid).
# LLM_API_KEY is the key for that provider:
#   gemini    -> free key from https://aistudio.google.com/apikey
#   anthropic -> key from https://console.anthropic.com
# Gemini free tier: Google may use inputs to improve its products, so only send
# synthetic or demo invoices, never real customer data.
LLM_PROVIDER=gemini
LLM_API_KEY=
# gemini-3.5-flash-lite has a larger free daily quota; gemini-3.8-flash allows only ~20 requests/day.
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Claude only: reasoning effort for extraction (low | medium | high | xhigh | max)
LLM_EFFORT_EXTRACT=medium
# Kill switch: set to false to stop all LLM calls
EXTRACTION_ENABLED=true
EXTRACTION_MAX_RETRIES=2
RENDER_MAX_EDGE=2000
# Validation warns when an invoice is older than this many days
MAX_INVOICE_AGE_DAYS=730

# HSN/SAC lookup (Phase 5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed keeps the model. Leave commented out for its default cache; the Docker image sets /app/models.
# EMBEDDING_CACHE_DIR=/path/to/models
# Suggest HSN/SAC codes for each line (one LLM call per invoice)
CLASSIFICATION_ENABLED=true
# Below this confidence, a suggested code is not shown as a suggestion; a person picks it
HSN_MIN_CONFIDENCE=0.6

# Tracing with Langfuse (optional; leave empty to skip tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Cost control and agent behaviour
# Budgets are enforced from Phase 6. Gemini free tier costs $0; Claude Opus 5.5 about $0.05-0.10 per invoice.
MAX_COST_PER_INVOICE_USD=0.25
DAILY_BUDGET_USD=2.00
AUTO_APPROVE_ENABLED=false
# Agent (Phase 6): targeted re-reads after validation errors, and a per-invoice token budget
MAX_REEXTRACTIONS=2
MAX_TOKENS_PER_INVOICE=60000
# Auto-approve (only when enabled) needs no issues, this confidence, and a confident HSN code per line
AUTO_APPROVE_MIN_CONFIDENCE=0.9
AUTO_APPROVE_MIN_HSN_CONFIDENCE=0.8

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Demo safety (blueprint section 18). A daily cap on real model calls and spend,
# reset at midnight India time. Gemini's free tier costs $0 per call, so the call
# limit is what protects the free quota. Demo invoices replay recorded replies and
# keep working after the cap is hit.
DAILY_LLM_CALL_LIMIT=300
DAILY_BUDGET_USD=1.0
# Per-user and per-IP rate limits on sign-in, upload, ask and demo (app/ratelimit.py)
RATE_LIMITS_ENABLED=true

# Job queue (backend/app/services/jobs.py). The worker thread runs inside the API process,
# retries passing errors and recovers reads cut off by a restart.
WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=3
# A job still "running" after this many seconds is assumed dead and is taken again
JOB_LEASE_SECONDS=300
WORKER_POLL_SECONDS=5

# Local MCP server only (backend/app/mcp_server.py): whose ledger query_ledger answers for
MCP_USER_EMAIL=
